# ── Database ──
DATABASE_URL=postgresql+psycopg2://scanner:scanner@localhost:5432/scanner_dashboard

# ── Redis (for arq task queue) ──
REDIS_URL=redis://localhost:6379/0

# ── JWT ──
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Scanner-v3 path (relative to backend/ or absolute) ──
SCANNER_V3_PATH=../../scanner-v3

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Telegram (optional — for alert delivery) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
