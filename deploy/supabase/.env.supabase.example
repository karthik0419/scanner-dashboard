# ── Supabase .env example ──
# Copy to backend/.env and fill in your Supabase project values

# Supabase Postgres (Project Settings > Database > Connection string)
# Format: postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Redis — use Upstash (free tier, serverless Redis)
# Create at https://upstash.com — get the Redis URL
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_UPSTASH_HOST:6379

# JWT
JWT_SECRET=YOUR_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Scanner-v3 path (on your cloud VM/container)
SCANNER_V3_PATH=/opt/scanner-v3

# CORS — your frontend domain
CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
